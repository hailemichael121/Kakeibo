{
  "name": "kakeibo",
  "private": true,
  "version": "1.0.0",
  "description": "Mindful offline-first personal budgeting",
  "author": "Kakeibo",
  "homepage": "https://example.com/kakeibo",
  "desktopName": "kakeibo.desktop",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:lan": "node --test desktop/lan.test.cjs",
    "lint": "eslint .",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "build:mobile": "npm run build && npx cap sync android",
    "cap:run:android": "npm run build:mobile && npx cap run android",
    "cap:run:ios": "npm run build && npx cap sync ios && npx cap run ios",
    "android:open": "npx cap open android",
    "android:assemble": "cd android && ./gradlew assembleDebug",
    "android:install": "npm run build:mobile && cd android && ./gradlew installDebug",
    "android:release": "npm run build:mobile && cd android && ./gradlew assembleRelease",
    "electron": "node desktop/dev.mjs",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:build": "npm run build && electron-builder",
    "desktop:build:win": "npm run build && electron-builder --win nsis",
    "desktop:build:linux": "npm run build && electron-builder --linux AppImage deb",
    "desktop:build:mac": "npm run build && electron-builder --mac dmg",
    "android:release:desktop": "npm run build:mobile && cd android && ./gradlew assembleRelease && cd .. && cp -f android/app/build/outputs/apk/release/Kakeibo-release-universal.apk \"$HOME/Desktop/Kakeibo.apk\"",
    "release": "npm run release:mobile && npm run desktop:build",
    "release:mobile": "npm run build:mobile && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@fontsource/plus-jakarta-sans": "^5.2.6",
    "dexie": "^4.0.11",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^9.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.6",
    "globals": "^15.14.0",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "main": "desktop/main.cjs"
}
